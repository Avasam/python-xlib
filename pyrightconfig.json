// https://github.com/microsoft/pyright/blob/main/docs/configuration.md#sample-config-file
{
  "typeCheckingMode": "basic",
  "analyzeUnannotatedFunctions": false,
  // Oldest Python pyright can check for, typeshed only has `typing` from Python 3.5. For editors, since uv can't make venvs that old.
  "pythonVersion": "3.5",

  /**
   * Specific to this project
   */
  // Only the public API
  "include": ["Xlib"],
}
